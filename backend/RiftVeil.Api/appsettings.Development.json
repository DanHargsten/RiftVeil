    "RateLimitMaxAttempts": 12,
    "RateLimitExtendedCooldownMilliseconds": 90000,
    "RateLimitBackoffBaseMilliseconds": 2000,
    "RateLimitBackoffMaxMilliseconds": 60000,
    "CargoPageSize": 500,
    "TransientApiErrorBackoffBaseMilliseconds": 5000,
    "TransientApiErrorBackoffMaxMilliseconds": 60000
  }
